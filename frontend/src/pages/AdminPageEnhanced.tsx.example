// Example of enhanced AdminPage features
// This shows the structure for the 10 improvements

import { useState } from 'react';
import { Search, Filter, Download, Mail, AlertCircle, Activity } from 'lucide-react';

// ===== 1. USER SEARCH & FILTERING =====
function UserSearchAndFilter() {
  const [search, setSearch] = useState('');
  const [tierFilter, setTierFilter] = useState('');
  const [statusFilter, setStatusFilter] = useState('');
  
  return (
    <div className="flex gap-4 mb-4">
      {/* Search Box */}
      <div className="flex-1 relative">
        <Search className="absolute left-3 top-3 w-4 h-4 text-gray-400" />
        <input
          type="text"
          placeholder="Search users by email, name, or ID..."
          value={search}
          onChange={(e) => setSearch(e.target.value)}
          className="w-full pl-10 pr-4 py-2 border rounded-lg"
        />
      </div>
      
      {/* Tier Filter */}
      <select
        value={tierFilter}
        onChange={(e) => setTierFilter(e.target.value)}
        className="border rounded-lg px-4 py-2"
      >
        <option value="">All Tiers</option>
        <option value="starter">Starter</option>
        <option value="pro">Pro</option>
        <option value="enterprise">Enterprise</option>
      </select>
      
      {/* Status Filter */}
      <select
        value={statusFilter}
        onChange={(e) => setStatusFilter(e.target.value)}
        className="border rounded-lg px-4 py-2"
      >
        <option value="">All Status</option>
        <option value="active">Active</option>
        <option value="trial">Trial</option>
        <option value="cancelled">Cancelled</option>
      </select>
    </div>
  );
}

// ===== 2. ACTIVITY LOG TAB =====
function ActivityLogTab() {
  const [logs, setLogs] = useState([]);
  
  return (
    <div className="bg-white rounded-lg shadow p-6">
      <h2 className="text-xl font-semibold mb-4 flex items-center gap-2">
        <Activity className="w-5 h-5" />
        Activity Log
      </h2>
      
      <div className="space-y-2">
        {logs.map(log => (
          <div key={log.id} className="border-l-4 border-blue-500 pl-4 py-2">
            <div className="flex justify-between">
              <span className="font-medium">{log.event_type}</span>
              <span className="text-sm text-gray-500">{log.timestamp}</span>
            </div>
            <div className="text-sm text-gray-600">{log.user_email}</div>
            <div className="text-xs text-gray-500">{JSON.stringify(log.details)}</div>
          </div>
        ))}
      </div>
      
      <button className="mt-4 flex items-center gap-2 text-blue-600">
        <Download className="w-4 h-4" />
        Export Audit Log
      </button>
    </div>
  );
}

// ===== 3. BULK OPERATIONS =====
function BulkOperationsToolbar({ selectedUsers }) {
  return (
    <div className="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-4">
      <div className="flex items-center justify-between">
        <span className="font-medium">
          {selectedUsers.length} users selected
        </span>
        <div className="flex gap-2">
          <button className="px-4 py-2 bg-green-600 text-white rounded-lg">
            Activate Selected
          </button>
          <button className="px-4 py-2 bg-red-600 text-white rounded-lg">
            Suspend Selected
          </button>
          <button className="px-4 py-2 bg-blue-600 text-white rounded-lg flex items-center gap-2">
            <Mail className="w-4 h-4" />
            Send Email
          </button>
        </div>
      </div>
    </div>
  );
}

// ===== 4. QUICK ACTIONS PANEL =====
function QuickActionsPanel({ user }) {
  return (
    <div className="bg-gray-50 rounded-lg p-4 space-y-2">
      <h3 className="font-semibold mb-3">Quick Actions</h3>
      
      <button className="w-full text-left px-3 py-2 bg-white border rounded hover:bg-gray-50">
        🎁 Extend Trial (7 days)
      </button>
      
      <button className="w-full text-left px-3 py-2 bg-white border rounded hover:bg-gray-50">
        🔑 Reset Password
      </button>
      
      <button className="w-full text-left px-3 py-2 bg-white border rounded hover:bg-gray-50">
        💰 Process Refund
      </button>
      
      <button className="w-full text-left px-3 py-2 bg-white border rounded hover:bg-gray-50">
        📧 Send Email
      </button>
    </div>
  );
}

// ===== 5. SYSTEM HEALTH DASHBOARD =====
function SystemHealthDashboard() {
  return (
    <div className="grid grid-cols-3 gap-4">
      <div className="bg-white rounded-lg shadow p-4">
        <div className="flex items-center justify-between">
          <span className="text-sm text-gray-600">Database</span>
          <div className="w-3 h-3 bg-green-500 rounded-full" />
        </div>
        <div className="text-2xl font-bold mt-2">Healthy</div>
        <div className="text-xs text-gray-500">Response: 12ms</div>
      </div>
      
      <div className="bg-white rounded-lg shadow p-4">
        <div className="flex items-center justify-between">
          <span className="text-sm text-gray-600">API</span>
          <div className="w-3 h-3 bg-green-500 rounded-full" />
        </div>
        <div className="text-2xl font-bold mt-2">99.9%</div>
        <div className="text-xs text-gray-500">Uptime: 30 days</div>
      </div>
      
      <div className="bg-white rounded-lg shadow p-4">
        <div className="flex items-center justify-between">
          <span className="text-sm text-gray-600">Storage</span>
          <div className="w-3 h-3 bg-yellow-500 rounded-full" />
        </div>
        <div className="text-2xl font-bold mt-2">78%</div>
        <div className="text-xs text-gray-500">12.4 GB / 16 GB</div>
      </div>
    </div>
  );
}

// ===== 6. REVENUE DASHBOARD =====
function RevenueDashboard() {
  return (
    <div className="bg-white rounded-lg shadow p-6">
      <h2 className="text-xl font-semibold mb-4">Revenue Analytics</h2>
      
      <div className="grid grid-cols-4 gap-4 mb-6">
        <div className="text-center">
          <div className="text-2xl font-bold text-green-600">$12,450</div>
          <div className="text-sm text-gray-600">MRR</div>
        </div>
        <div className="text-center">
          <div className="text-2xl font-bold text-blue-600">+23%</div>
          <div className="text-sm text-gray-600">Growth</div>
        </div>
        <div className="text-center">
          <div className="text-2xl font-bold text-purple-600">$2,890</div>
          <div className="text-sm text-gray-600">LTV</div>
        </div>
        <div className="text-center">
          <div className="text-2xl font-bold text-red-600">4.2%</div>
          <div className="text-sm text-gray-600">Churn</div>
        </div>
      </div>
      
      {/* Chart would go here */}
      <div className="h-64 bg-gray-100 rounded flex items-center justify-center">
        Revenue Chart (use recharts or chart.js)
      </div>
    </div>
  );
}

export { 
  UserSearchAndFilter, 
  ActivityLogTab, 
  BulkOperationsToolbar,
  QuickActionsPanel,
  SystemHealthDashboard,
  RevenueDashboard
};
